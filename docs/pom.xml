<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================
         Parent: Spring Boot 3.x BOM — gerencia versões de dependências
         ================================================================ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- ================================================================
         Identificação do artefato
         ================================================================ -->
    <groupId>com.hackathon</groupId>
    <artifactId>triagem-ia</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>triagem-ia</name>
    <description>Sistema de Triagem Assistida por IA — Hackathon ADS</description>

    <!-- ================================================================
         Propriedades: Java 21 obrigatório (conforme .cursorrules)
         ================================================================ -->
    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.5.0</springdoc.version>
    </properties>

    <!-- ================================================================
         Dependências
         ================================================================ -->
    <dependencies>

        <!-- Spring Web: expõe controllers REST e serve arquivos estáticos -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA: ORM + Repository pattern sobre Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation: @NotBlank, @Min, @Max em TriagemRequest -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- H2: banco in-memory (dados perdidos ao reiniciar — comportamento esperado) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- springdoc-openapi: Swagger UI em /swagger-ui.html (substitui SpringFox) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Spring Boot Test: JUnit 5 + Mockito + @SpringBootTest -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ================================================================
         Build
         — sourceDirectory: aponta para src/back_end (Java)
         — resources: empacota src/front_end como static/ no JAR
         ================================================================ -->
    <build>

        <!-- Código Java do backend fica em src/back_end/ -->
        <sourceDirectory>${project.basedir}/src/back_end</sourceDirectory>

        <!-- Testes permanecem no caminho padrão Maven -->
        <testSourceDirectory>${project.basedir}/src/test/java</testSourceDirectory>

        <resources>
            <!-- Frontend: src/front_end/ → empacotado em static/ dentro do JAR -->
            <!-- Spring Boot serve automaticamente tudo em static/ na raiz (/) -->
            <resource>
                <directory>${project.basedir}/src/front_end</directory>
                <targetPath>static</targetPath>
            </resource>
            <!-- Configurações: application.properties permanece no caminho padrão -->
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
        </resources>

        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
            </testResource>
        </testResources>

        <plugins>
            <!-- spring-boot-maven-plugin: empacota fat JAR e permite mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>

    </build>

</project>
